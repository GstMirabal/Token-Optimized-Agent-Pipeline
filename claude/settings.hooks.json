{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin:*)",
      "Bash(rm -rf /:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "if [ -f .agents/hooks/on_init.py ]; then python3 .agents/hooks/on_init.py; else echo '⚠️ [.agents] hooks unavailable — initialize the submodule: git submodule update --init .agents && .agents/scripts/install_claude.sh'; fi" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "if [ -f .agents/hooks/on_commit.py ]; then python3 .agents/hooks/on_commit.py; fi" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "if [ -f .agents/hooks/state_mirror.py ]; then python3 .agents/hooks/state_mirror.py; fi" }
        ]
      }
    ]
  }
}
