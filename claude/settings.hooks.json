{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin:*)",
      "Bash(rm -rf /:*)",
      "Edit(/.agents/**)",
      "Edit(/.git/modules/.agents/**)",
      "Edit(/.env)",
      "Read(/.env)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.docker/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/Library/Keychains/**)",
      "Edit(/.claude/settings*.json)",
      "Read(/**/.env*)",
      "Read(~/.config/agents-broker/**)",
      "Edit(~/.config/agents-broker/**)",
      "Write(~/.config/agents-broker/**)",
      "Read(~/.claude.json)",
      "Edit(~/.claude.json)",
      "Write(~/.claude.json)",
      "WebFetch",
      "WebSearch",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "PushNotification",
      "RemoteTrigger",
      "SendMessage",
      "mcp__claude_ai_Google_Drive",
      "mcp__claude_ai_Claude_Docs",
      "mcp__claude_ai_Gmail"
    ],
    "allow": [
      "Bash(cd:*)",
      "Bash(jq:*)",
      "Bash(tee:*)",
      "Bash(xargs:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(which:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(tr:*)",
      "Bash(cut:*)"
    ]
  },
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Never force-push or rewrite published git history.",
      "Never delete a repository or wipe the filesystem root (rm -rf /).",
      "Never exfiltrate secrets, .env contents, or credential files to external destinations."
    ],
    "soft_deny": [
      "$defaults",
      "Do not run git clean that deletes untracked files without explicit user confirmation.",
      "Do not run docker compose down -v (volume wipe) without explicit user confirmation.",
      "Do not run a destructive git reset --hard on the working tree without explicit user confirmation."
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "api.github.com",
        "github.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.*",
        "~/.docker/config.json",
        "~/.config/gh",
        "~/.zsh_history",
        "~/.claude/projects",
        "~/Library/Keychains/login.keychain-db",
        "~/.ssh",
        "~/.aws",
        "~/.npmrc",
        "~/.bash_history",
        "~/**/.env*",
        "~/.config/agents-broker",
        "~/.claude.json"
      ],
      "allowRead": [
        "./.env.example",
        "./.env.sample",
        "./.env.template"
      ],
      "denyWrite": [
        "./.agents",
        "./.git/modules/.agents",
        "./.env"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "./.env",
          "mode": "deny"
        }
      ]
    }
  },
  "fileCheckpointingEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .agents/hooks/on_init.py ]; then python3 .agents/hooks/on_init.py; else echo '\u26a0\ufe0f [.agents] hooks unavailable \u2014 initialize the submodule: git submodule update --init .agents && python3 .agents/scripts/install.py'; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .agents/hooks/on_commit.py ]; then python3 .agents/hooks/on_commit.py; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .agents/hooks/state_mirror.py ]; then python3 .agents/hooks/state_mirror.py; fi"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .agents/scripts/persist_session_context.py ]; then python3 .agents/scripts/persist_session_context.py; fi"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f docs/active_state.json ]; then echo '[.agents] PostCompact: re-read docs/active_state.json and the current sprint task_scope.md (anti_amnesia)'; fi"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .agents/scripts/session_end_hook.py ]; then python3 .agents/scripts/session_end_hook.py; fi"
          }
        ]
      }
    ]
  },
  "plansDirectory": "docs/plans"
}
